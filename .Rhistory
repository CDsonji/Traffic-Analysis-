filter(Year %in% c(1391, 1392)) %>%
mutate(
Period = ifelse(Year < 1392, "Before_1392", "After_1392")
)
t.test(
`Gas_Consumption` ~ Period,
data = total_data_1392,
conf.level = 0.95
)
total_data_1397 <- total_data %>%
filter(Year %in% c(1396, 1397)) %>%
