write.csv(
anova_table,
file = "csv/ANOVA_Province_GasConsumption.csv",
row.names = TRUE
)
tukey_ci <- TukeyHSD(
anova_model,
conf.level = 0.95
)
tukey_ci
tukey_total_data <- as.data.frame(tukey_ci$Province)
tukey_total_data$Comparison <- rownames(tukey_total_data)
