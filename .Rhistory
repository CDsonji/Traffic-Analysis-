)
#---------------------------- Correlation and Regression ----------------------------
dir.create("csv", showWarnings = FALSE)
vars_corr <- total_data[, c(
"Gas_Consumption",
"Real_Price",
"Registered_Cars",
"Intra_Provincial_Trips"
)]
cor_matrix <- cor(vars_corr)
round(cor_matrix, 3)
write.csv(
cor_matrix,
file = "csv/Correlation_Matrix_GasConsumption.csv",
row.names = TRUE
)
cor_with_Y <- cor_matrix[-1, 1]
abs_cor <- abs(cor_with_Y)
best_X_name <- names(which.max(abs_cor))
best_X_value <- cor_with_Y[best_X_name]
best_X_name
best_X_value
formula_simple <- as.formula(
paste("`Gas_Consumption` ~ `", best_X_name, "`", sep = "")
)
model_simple <- lm(formula_simple, data = total_data)
summary(model_simple)
library(ggplot2)
p <- ggplot(
total_data,
aes(
x = .data[[best_X_name]],
y = `Gas_Consumption`
)
) +
geom_point(color = "black", size = 2) +
geom_smooth(method = "lm", se = FALSE, color = "red", linewidth = 1) +
labs(
x = best_X_name,
y = "Gas_Consumption"
) +
theme_minimal()
dir.create("regression_plots", showWarnings = FALSE)
file_name <- paste0(
"regression_plots/Scatter_Gas_Consumption_vs_",
gsub("[^A-Za-z0-9]", "_", best_X_name),
".png"
)
ggsave(
filename = file_name,
plot = p,
width = 8,
height = 6,
dpi = 300
)
multi_model <- lm(
`Gas_Consumption` ~
`Real_Price` +
`Registered_Cars` +
`Intra_Provincial_Trips`,
data = total_data
)
summary(multi_model)
#---------------------------- Model Selection and Diagnostics ----------------------------
full_model <- lm(
`Gas_Consumption` ~
`Real_Price` +
`Registered_Cars` +
`Intra_Provincial_Trips`,
data = total_data
)
step_model <- step(full_model, direction = "both", trace = FALSE)
summary(step_model)
library(tidyverse)
dir.create("diagnostics", showWarnings = FALSE)
resid_df <- tibble(
residuals = residuals(step_model)
)
qq_plot <- ggplot(resid_df, aes(sample = residuals)) +
stat_qq() +
stat_qq_line(color = "red") +
labs(
title = "Q-Q Plot of Residuals",
x = "Theoretical Quantiles",
y = "Sample Quantiles"
) +
theme_minimal()
ggsave(
filename = "diagnostics/qqplot_residuals_step_model.png",
plot = qq_plot,
width = 6,
height = 6,
dpi = 300
)
library(tidyverse)
dir.create("diagnostics", showWarnings = FALSE)
resid_df <- tibble(
fitted = fitted(step_model),
residuals = residuals(step_model)
)
rvf_plot <- ggplot(resid_df, aes(x = fitted, y = residuals)) +
geom_point(alpha = 0.6) +
geom_hline(yintercept = 0, color = "red", lwd = 1) +
labs(
title = "Residuals vs Fitted Values",
x = "Fitted Values",
y = "Residuals"
) +
theme_minimal()
ggsave(
filename = "diagnostics/residuals_vs_fitted_step_model.png",
plot = rvf_plot,
width = 6,
height = 6,
dpi = 300
)
library(car)
vif(step_model)
load("D:/Uni/Statistics Project/.RData")
library(tidyverse)
library(readxl)
#---------------------------- load data ----------------------------
total_data <- read_xlsx("total_data.xlsx")
options(scipen = 999)
#---------------------------- descriptive stats ----------------------------
dir.create("csv", showWarnings = FALSE)
descriptive_stats <- total_data %>%
select(
Gas_Consumption,
Nominal_Price,
CPI,
Real_Price,
Registered_Cars,
Intra_Provincial_Trips
) %>%
pivot_longer(
cols = everything(),
names_to = "Variable",
values_to = "Value"
) %>%
group_by(Variable) %>%
summarise(
Mean = mean(Value, na.rm = TRUE),
Median = median(Value, na.rm = TRUE),
Variance = var(Value, na.rm = TRUE),
SD = sd(Value, na.rm = TRUE),
Min = min(Value, na.rm = TRUE),
Max = max(Value, na.rm = TRUE)
)
print(descriptive_stats)
write_csv(descriptive_stats, "csv/descriptive_statistics.csv")
#---------------------------- boxplots ----------------------------
library(ggplot2)
vars <- c(
"Gas_Consumption",
"Nominal_Price",
"Real_Price",
"Registered_Cars",
"Intra_Provincial_Trips"
)
library(ggplot2)
dir.create("boxplots", showWarnings = FALSE)
for (v in vars) {
p <- ggplot(total_data, aes_string(y = v)) +
geom_boxplot(
fill = "skyblue",
outlier.color = "red",
outlier.size = 2
) +
theme_minimal() +
labs(
title = paste("Boxplot of", v),
y = v
)
p
ggsave(
filename = paste0("boxplots/boxplot_", v, ".png"),
plot = p,
width = 6,
height = 4,
dpi = 300
)
}
