)
t.test(`Gas_Consumption` ~ Period, data = total_data_1385)
total_data_1389 <- total_data %>%
filter(Year %in% c(1388, 1389)) %>%
mutate(
Period = ifelse(Year < 1389, "Before_1389", "After_1389")
)
t.test(`Gas_Consumption` ~ Period, data = total_data_1389)
